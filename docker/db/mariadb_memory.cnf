[mysqld]
# --- Память ---
innodb_buffer_pool_size = 128M           # главный параметр — кэш InnoDB, не больше 25-30% RAM
innodb_buffer_pool_instances = 1         # одного экземпляра достаточно при pool < 1GB
innodb_log_file_size    = 32M            # размер лога транзакций
innodb_log_buffer_size  = 8M            # буфер перед записью в лог
key_buffer_size         = 16M            # кэш для MyISAM (системные таблицы)
tmp_table_size          = 16M            # макс. размер временной таблицы в памяти
max_heap_table_size     = 16M            # должен совпадать с tmp_table_size
query_cache_type        = 0              # query cache устарел, отключаем
query_cache_size        = 0

# --- Соединения ---
max_connections         = 30             # php-fpm воркеров обычно 5-10, берём с запасом
max_connect_errors      = 100
connect_timeout         = 10
wait_timeout            = 60             # закрывать idle-соединения через 60 сек
interactive_timeout     = 60
thread_cache_size       = 8              # кэшировать потоки, чтобы не пересоздавать

# --- InnoDB I/O ---
innodb_flush_log_at_trx_commit = 2       # 1 = надёжно но медленно, 2 = баланс
innodb_flush_method     = O_DIRECT       # не дублировать кэш ОС и InnoDB
innodb_file_per_table   = 1              # каждая таблица в своём файле — проще обслуживать
innodb_io_capacity      = 200            # IOPS диска (для обычного VDS HDD/SSD)

# --- Производительность ---
performance_schema      = OFF            # отключаем — экономит ~50-100MB памяти
max_allowed_packet      = 16M
table_open_cache        = 256
open_files_limit        = 65535
sort_buffer_size        = 1M             # буфер сортировки на каждое соединение
read_buffer_size        = 512K
read_rnd_buffer_size    = 512K
join_buffer_size        = 512K

# --- Логирование ---
log_error               = /var/log/mysql/error.log
slow_query_log          = 1
slow_query_log_file     = /var/log/mysql/slow.log
long_query_time         = 2              # логировать запросы дольше 2 секунд
log_queries_not_using_indexes = 0        # не спамить в лог

[client]
default-character-set   = utf8mb4

[mysql]
default-character-set   = utf8mb4